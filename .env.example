# Copy to .env for local runs. In CI these come from GitHub Secrets.
# Never commit real values.

# Postgres connection string (Supabase or Neon). Leave empty to write to data/local/ instead.
DATABASE_URL=

# Nasdaq reference prices: https://finnhub.io
FINNHUB_KEY=

# Agent API payments (set these in Vercel for the web/ app)
# NEAR account that receives 0.25 USDC per answer through NEAR Intents 1Click
ASSAYER_NEAR_ACCOUNT=
# Any random string of 16+ characters; signs payment tokens
PAYMENT_SECRET=
# Optional: 1Click API key from https://partners.near-intents.org, lowers swap fees
ONECLICK_API_KEY=

# NEAR AI Cloud key (https://cloud.near.ai): writes the one-line reason in paid answers
NEARAI_API_KEY=
# Optional, defaults to z-ai/glm-5.3-flash
NEARAI_MODEL=
